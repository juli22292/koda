{
  "name": "koda-desktop",
  "version": "0.2.2",
  "private": true,
  "description": "Dein lokaler Coding-Workspace. Deine Modelle, deine API-Keys.",
  "main": "out/main/index.js",
  "author": "Koda",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "preview:web": "vite --config vite.web.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e.cjs",
    "test:agent": "node scripts/agent-e2e.cjs",
    "dist": "npm run build && node scripts/package.cjs",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir --publish never",
    "release": "node scripts/release.cjs",
    "release:publish": "node scripts/publish-release.cjs",
    "test:updates": "node scripts/update-e2e.cjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.92",
    "@ai-sdk/google": "^4.0.108",
    "@ai-sdk/openai": "^4.0.105",
    "@ai-sdk/openai-compatible": "^3.0.81",
    "@ai-sdk/xai": "^5.0.33",
    "ai": "^7.0.157",
    "electron-updater": "^6.8.11",
    "semver": "^7.8.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.0.1",
    "diff": "^8.0.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^6.0.0",
    "js-yaml": "^5.5.0",
    "lucide-react": "^0.577.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "studio.koda.desktop",
    "productName": "Koda",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Koda-Setup-${version}-${arch}.${ext}",
      "icon": "resources/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "juli22292",
      "repo": "koda-releases",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Koda",
      "uninstallDisplayName": "Koda",
      "deleteAppDataOnUninstall": false,
      "include": "resources/installer.nsh",
      "installerLanguages": [
        "de_DE",
        "en_US"
      ],
      "runAfterFinish": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/juli22292/koda.git"
  },
  "homepage": "https://github.com/juli22292/koda-releases"
}
